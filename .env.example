# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical links, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery.
# Without RESEND_API_KEY, messages are printed to the server log in development.
# In production a key is required; otherwise the form asks visitors to email us directly.
RESEND_API_KEY=
# Where contact messages are delivered (defaults to the foundation's address).
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "AWF website <hello@awf.org>".
CONTACT_FROM_EMAIL=
# Optional override: "log" or "resend".
EMAIL_TRANSPORT=
